{
  "name": "webgpu-fractal-zoomer",
  "private": true,
  "version": "1.4.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "validate:wgsl": "node scripts/validate-wgsl-source.mjs",
    "validate:v1": "node scripts/validate-v1-invariants.mjs",
    "validate:v11": "node scripts/validate-v11-invariants.mjs",
    "validate:v12": "node scripts/validate-v12-invariants.mjs",
    "validate:v13": "node scripts/validate-v13-invariants.mjs",
    "validate:persistent": "node scripts/validate-persistent-architecture.mjs",
    "validate:phase1": "node scripts/validate-phase1-presentation.mjs",
    "validate:release": "node scripts/validate-release-invariants.mjs",
    "validate:v14": "node scripts/validate-v14-invariants.mjs",
    "validate:provenance": "node scripts/validate-provenance-oracle.mjs",
    "validate:numerical": "node scripts/validate-numerical-contract.mjs",
    "validate:precision-overlap": "node scripts/validate-precision-overlap.mjs",
    "validate:numerical-browser-build": "tsc -p tests/tsconfig.numerical.json --pretty false",
    "test:continuity-browser": "node scripts/run-continuity-browser-gate.mjs",
    "test:numerical-browser": "node scripts/run-numerical-browser-gate.mjs",
    "test:performance-browser": "node scripts/run-performance-browser-gate.mjs",
    "test:precision-browser": "node scripts/run-precision-overlap-browser-gate.mjs",
    "validate:v6": "node scripts/validate-v6-invariants.mjs",
    "build": "node scripts/validate-release-invariants.mjs && node scripts/validate-wgsl-source.mjs && node scripts/validate-v1-invariants.mjs && node scripts/validate-v11-invariants.mjs && node scripts/validate-v12-invariants.mjs && node scripts/validate-v13-invariants.mjs && node scripts/validate-persistent-architecture.mjs && node scripts/validate-phase1-presentation.mjs && node scripts/validate-v14-invariants.mjs && node scripts/validate-performance-pipeline.mjs && node scripts/validate-precision-overlap.mjs && node scripts/validate-provenance-oracle.mjs && node scripts/validate-numerical-contract.mjs && tsc -p tests/tsconfig.numerical.json --pretty false && tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.64",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "wgsl_reflect": "^1.5.0"
  }
}

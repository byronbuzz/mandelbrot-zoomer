{
  "name": "mandelbrot-zoomer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:wgsl": "node scripts/validate-wgsl-source.mjs",
    "validate:v6": "node scripts/validate-v6-invariants.mjs",
    "build": "npm run validate:wgsl && npm run validate:v6 && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.64",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "wgsl_reflect": "^1.5.0"
  }
}
